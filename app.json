{
  "expo": {
    "name": "360-saksi",
    "slug": "360-saksi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/saksi360_emblem.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "updates": {
      "checkAutomatically": "NEVER",
      "enabled": false
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.saksi360.app",
      "adaptiveIcon": {
        "backgroundColor": "#1E293B",
        "foregroundImage": "./assets/brand/saksi360_emblem.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/brand/saksi360_emblem.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Saksi 360 memerlukan akses kamera untuk foto selfie presensi dan pemindaian dokumen."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Saksi 360 memerlukan akses lokasi untuk memverifikasi titik presensi GPS di TPS."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Saksi 360 memerlukan akses galeri untuk mengunggah foto dokumen.",
          "cameraPermission": "Saksi 360 memerlukan akses kamera untuk memotret dokumen."
        }
      ]
    ]
  }
}
